{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    // ESM settings
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    // Type checking and interop
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Debug
    "sourceMap": true
  },
  "include": ["src/**/*"]
}