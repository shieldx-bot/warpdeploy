    {
      "compilerOptions": {
        "target": "es2018", // or a newer version
        "module": "commonjs", // or "esnext" for ES modules
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
      },
      "include": ["src/**/*.ts"],
      "exclude": ["node_modules"]
    }